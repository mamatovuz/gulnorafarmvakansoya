# Telegram bot token (@BotFather dan oling)
BOT_TOKEN=123456:ABC-DEF...

# Bosh administrator Telegram ID (@userinfobot dan biling)
# Bir nechta bo'lsa vergul bilan: 123456789,987654321
SUPER_ADMINS=123456789

# Ma'lumotlar bazasi fayli
DB_PATH=hrbot.db

# ================= REST API (python -m api) =================
API_HOST=127.0.0.1
API_PORT=8090
# Vergul bilan: https://app.staffora.uz  (bo'sh => CORS o'chiq, server-server uchun kerak emas)
API_CORS_ORIGINS=
API_RATE_LIMIT_PER_MINUTE=120
API_DOCS_ENABLED=true
API_WORKERS_ENABLED=true
API_WORKER_INTERVAL_SECONDS=5
# false => e'lon/bildirishnomalar navbatda qoladi, Telegramga yuborilmaydi
API_TELEGRAM_SEND_ENABLED=true
# Webhook
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_BACKOFF_BASE_SECONDS=30
WEBHOOK_REQUIRE_HTTPS=false
# Staffora -> bot kiruvchi webhook HMAC kaliti (Staffora bilan kelishiladi)
INTEGRATION_INBOUND_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE=86400
API_EVENT_SOURCE=employee_bot
COMPANY_NAME=Gulnora Farm
